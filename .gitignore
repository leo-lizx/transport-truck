# IAR 编译和工程产生的中间垃圾文件
settings/
Debug/
Release/
*.dep
*.pbi
*.pbd
*.pbw
*.o
*.out
*.map
*.hex
*.bin
*.sim
*.dni
*.jlink
*.xcl
*.cspy.bat
*.cspy.ps1
BrowseInfo/

# VS Code 产生的临时文件
.vscode/ipch/
*.code-workspace

# VS Code 自动生成的本地调试配置
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json

# IAR/Eclipse 工作区元数据（本机相关）
project/iar/.metadata/

# IAR 构建产物目录（按配置名区分）
project/iar/program/*/BrowseInfo/
project/iar/program/*/Exe/
project/iar/program/*/List/
project/iar/program/*/Obj/
project/iar/program/*/.ninja_deps
project/iar/program/*/.ninja_log
project/iar/program/*/.rt1064_build_cache

# Office 临时锁文件
project/~$*.xlsx

# 其他系统垃圾
.DS_Store
Thumbs.db
# 编译构建工具 (Ninja/VS Code 插件) 产生的缓存文件
.ninja_deps
.ninja_log
.rt1064_build_cache
.vs/
# Office 临时文件
~$*

# IAR/Eclipse 产生的本地工作空间元数据
.metadata/

# 确保过滤所有层级的构建缓存（加星号适配多级目录）
*.ninja_deps
*.ninja_log
*.rt1064_build_cache