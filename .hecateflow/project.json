{
  "$schema": "hecateflow/manifest-v1",
  "version": 1,
  "workspace": {
    "name": "transport-truck",
    "mcuFamily": "NXP RT1064DVL6A",
    "arch": "Cortex-M7",
    "toolchain": "IAR EWARM 9.2",
    "language": "c",
    "encoding": "utf-8-no-bom",
    "indent": "4-spaces",
    "scenario": {
      "domain": "工程系统设计运输车（任务逻辑待构建）",
      "constraints": [],
      "safetyRules": [],
      "forbidden": []
    },
    "lsp": {
      "clangd": true,
      "configStyle": "c_cpp_properties.json"
    }
  },
  "paths": {
    "preferRelative": true
  },
  "buildSystem": {
    "type": "iar",
    "autoDiscover": false,
    "registration": {
      "projectFile": "project/iar/program/rt1064.ewp",
      "sourceNode": "code",
      "includePathField": "",
      "lspConfig": ".vscode/c_cpp_properties.json"
    }
  },
  "targets": [
    {
      "id": "rt1064-main",
      "description": "RT1064 主控基础 — 底盘运动控制 + 保留的串口链路",
      "buildTarget": "nor_sdram_zf_dtcm",
      "layout": {
        "style": "feature-subdirs",
        "subdirs": ["config", "chassis", "app", "algo"]
      },
      "headers": {
        "pinMap": "project/code/config/pinMap.h",
        "configHeaders": ["project/code/config/configChassis.h"],
        "polaritySource": "project/code/config/configChassis.h §极性段"
      },
      "ownedPeripherals": [
        {"device": "LPUART4",      "owner": "rt1064-main", "io": true,  "gate": "whitelist-#if", "planNote": "OpenART1 地图帧 C16/C17, 115200bps CRC8"},
        {"device": "LPUART1",      "owner": "rt1064-main", "io": true,  "gate": "whitelist-#if", "planNote": "OpenART2 分类数据 B12/B13, 115200bps CRC8"},
        {"device": "SPI3",         "owner": "rt1064-main", "io": false, "gate": "none",           "planNote": "IPS200 硬件接口（旧菜单已移除） SCK=B0 MOSI=B1 RST=B2 DC=C19 CS=B3 BL=C18"},
        {"device": "SPI4",         "owner": "rt1064-main", "io": false, "gate": "none",           "planNote": "IMU660RB 航向传感器 SCK=C23 MOSI=C22 MISO=C21 CS=C20"},
        {"device": "QTIMER1",      "owner": "rt1064-main", "io": false, "gate": "none",           "planNote": "编码器 LB(ENC1)+RB(ENC2)"},
        {"device": "QTIMER2",      "owner": "rt1064-main", "io": false, "gate": "none",           "planNote": "编码器 LF(ENC4)+RF(ENC3)"},
        {"device": "PWM2",         "owner": "rt1064-main", "io": false, "gate": "none",           "planNote": "四路电机 PWM 载波 17kHz"},
        {"device": "GPIO_C10_C7_D2_C9", "owner": "rt1064-main", "io": false, "gate": "none",     "planNote": "四路电机方向控制 (推挽输出)"},
        {"device": "GPIO_C15_C14_C13_C12", "owner": "rt1064-main", "io": false, "gate": "none",  "planNote": "按键 K1-K4 (key_scanner 轮询)"}
      ],
      "hazardFiles": [],
      "companionFiles": [],
      "docPath": "PROJECT.md"
    }
  ],
  "docs": {
    "rootGuide": "代码编写与变更规范.md",
    "sharedLibVersions": "",
    "glossary": "",
    "pinout": "docs/PINOUT.md"
  },
  "lessons": {
    "dir": ".hecateflow/lessons/",
    "index": ".hecateflow/lessons/INDEX.md"
  },
  "autoInjection": {
    "instructionsFiles": [
      "代码编写与变更规范.md",
      ".claude/rules/embedded-safety.md",
      ".claude/rules/c-style.md"
    ],
    "mirrorPairs": [
      {"a": "CLAUDE.md", "b": "AGENTS.md"}
    ],
    "hooks": []
  },
  "activeChecks": {
    "targetConfirm": true,
    "volatile": true,
    "isrSafety": true,
    "numericSafety": true,
    "style": true,
    "docSync": true,
    "polarityMagnitude": true,
    "relativePaths": true,
    "ioOwnership": true,
    "lessonsCapture": true
  },
  "git": {
    "commitFormat": "{模块} {动作/说明}  — 中文短句，如: 地图识别 重构、底盘 PID 参数调优、视觉链路 超时修复",
    "remotes": ["origin"],
    "defaultBranch": "main",
    "neverAddAll": true
  }
}
